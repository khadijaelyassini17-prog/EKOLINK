{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
  "color": {
    "custom": false,
    "defaultPalette": false,
    "palette": [
      { "slug": "bg-page",            "name": "Fond de page",                   "color": "#EFF5E9" },
      { "slug": "bg-surface",         "name": "Fond de surface",                "color": "#FFFFFF" },
      { "slug": "bg-section",         "name": "Fond de section",                "color": "#143C3D" },
      { "slug": "text-default",       "name": "Texte par défaut",               "color": "#1F2630" },
      { "slug": "text-muted",         "name": "Texte discret",                  "color": "#6F685E" },
      { "slug": "text-cta",           "name": "Texte de bouton",                "color": "#1F2630" },
      { "slug": "text-card",          "name": "Texte de carte",                 "color": "#1F2630" },
      { "slug": "text-inverse",       "name": "Texte inversé",                  "color": "#F8F5EE" },
      { "slug": "text-inverse-muted", "name": "Texte inversé discret",          "color": "#B8C0D0" },
      { "slug": "text-accent-dark",   "name": "Texte d'accent sur fond sombre", "color": "#C3E9A0" },
      { "slug": "cta-primary",        "name": "Bouton principal",               "color": "#C3E9A0" },
      { "slug": "cta-secondary",      "name": "Bouton secondaire",              "color": "#143C3D" },
      { "slug": "cta-tertiary",       "name": "Bouton tertiaire",               "color": "#1E5C4A" },
      { "slug": "menu",               "name": "Menu",                           "color": "#1E5C4A" },
      { "slug": "border-default",     "name": "Bordure par défaut",             "color": "#D9D2C7" },
      { "slug": "border-action",      "name": "Bordure d'action",               "color": "#1E5C4A" },
      { "slug": "error",              "name": "Erreur",                         "color": "#A8463C" }
    ]
  },

  "typography": {
    "customFontSize": false,
    "defaultFontSizes": false,
    "fluid": true,
    "fontFamilies": [
      { "slug": "heading", "name": "Titres (Montserrat)", "fontFamily": "Montserrat, sans-serif" },
      { "slug": "body",    "name": "Texte (Poppins)",     "fontFamily": "Poppins, sans-serif" },
      { "slug": "slogan",  "name": "Slogan (Fraunces)",   "fontFamily": "Fraunces, serif" }
    ],
    "fontSizes": [
      { "slug": "tag",           "name": "Tag (12 px)",              "size": "0.75rem" },
      { "slug": "caption",       "name": "Légende (13 px)",          "size": "0.8125rem" },
      { "slug": "body",          "name": "Texte courant (16 px)",    "size": "1rem" },
      { "slug": "button",        "name": "Bouton (16 px)",           "size": "1rem" },
      { "slug": "lead",          "name": "Texte en avant (19,2 px)", "size": "1.2rem" },
      { "slug": "h3",            "name": "Titre H3 (19,2 px)",       "size": "1.2rem" },
      { "slug": "h2",            "name": "Titre H2 (27,65 px)",      "size": "1.7281rem" },
      { "slug": "slogan-title",  "name": "Slogan titre (27,65 px)",  "size": "1.7281rem" },
      { "slug": "key-figure",    "name": "Chiffre clé (40 px)",      "size": "2.5rem" },
      { "slug": "slogan-footer", "name": "Slogan footer (40 px)",    "size": "2.5rem" },
      { "slug": "h1",            "name": "Titre H1 (47,78 px)",      "size": "2.9863rem" }
    ]
  },

  "custom": {
    "fontWeight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "radius": { "md": "0.5rem" },
    "borderWidth": "1px",
    "transition": "0.2s ease"
  },

  "spacing": {
    "units": ["rem", "px", "%"],
    "customSpacingSize": false,
    "defaultSpacingSizes": false,
    "spacingSizes": [
      { "slug": "sm",   "name": "sm (5 px)",    "size": "0.3125rem" },
      { "slug": "md",   "name": "md (8 px)",    "size": "0.5rem" },
      { "slug": "lg",   "name": "lg (16 px)",   "size": "1rem" },
      { "slug": "xlg",  "name": "xlg (24 px)",  "size": "1.5rem" },
      { "slug": "xxlg", "name": "xxlg (32 px)", "size": "2rem" }
    ]
  }
},



  "styles": {
  "color": {
    "background": "var(--wp--preset--color--bg-page)",
    "text": "var(--wp--preset--color--text-default)"
  },
  "typography": {
    "fontFamily": "var(--wp--preset--font-family--body)",
    "fontSize": "var(--wp--preset--font-size--body)",
    "fontWeight": "var(--wp--custom--font-weight--regular)",
    "lineHeight": "1.6"
  },
  "spacing": {
    "blockGap": "var(--wp--preset--spacing--lg)"
  },
  "elements": {
    "heading": {
      "color": { "text": "var(--wp--preset--color--text-default)" },
      "typography": {
        "fontFamily": "var(--wp--preset--font-family--heading)",
        "fontWeight": "var(--wp--custom--font-weight--bold)",
        "lineHeight": "1.2"
      }
    },
    "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--h1)" } },
    "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--h2)" } },
    "h3": {
      "typography": {
        "fontSize": "var(--wp--preset--font-size--h3)",
        "fontWeight": "var(--wp--custom--font-weight--semibold)"
      }
    },
    "link": {
      "color": { "text": "var(--wp--preset--color--cta-tertiary)" },
      ":hover": { "color": { "text": "var(--wp--preset--color--text-default)" } }
    },
    "button": {
      "color": {
        "background": "var(--wp--preset--color--cta-primary)",
        "text": "var(--wp--preset--color--text-cta)"
      },
      "typography": {
        "fontFamily": "var(--wp--preset--font-family--body)",
        "fontSize": "var(--wp--preset--font-size--button)",
        "fontWeight": "var(--wp--custom--font-weight--medium)"
      },
      "border": { "radius": "var(--wp--custom--radius--md)" },
      "spacing": {
        "padding": {
          "top": "var(--wp--preset--spacing--md)",
          "bottom": "var(--wp--preset--spacing--md)",
          "left": "var(--wp--preset--spacing--xlg)",
          "right": "var(--wp--preset--spacing--xlg)"
        }
      },
      ":hover": {
        "color": {
          "background": "var(--wp--preset--color--cta-tertiary)",
          "text": "var(--wp--preset--color--text-inverse)"
        }
      }
    }
  },
  "css": ".eco-lead{font-size:var(--wp--preset--font-size--lead)}.eco-caption{font-size:var(--wp--preset--font-size--caption)}.eco-caption-strong{font-size:var(--wp--preset--font-size--caption);font-weight:var(--wp--custom--font-weight--semibold)}.eco-tag{font-size:var(--wp--preset--font-size--tag);font-weight:var(--wp--custom--font-weight--medium)}.eco-key-figure{font-family:var(--wp--preset--font-family--heading);font-size:var(--wp--preset--font-size--key-figure);font-weight:var(--wp--custom--font-weight--bold)}.eco-slogan-title{font-family:var(--wp--preset--font-family--slogan);font-size:var(--wp--preset--font-size--slogan-title);font-style:italic}.eco-slogan-footer{font-family:var(--wp--preset--font-family--slogan);font-size:var(--wp--preset--font-size--slogan-footer);font-style:italic}"
}
}